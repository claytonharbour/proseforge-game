<Project Sdk="Microsoft.NET.Sdk">
  <!-- `make theme-check`: loads theme packs from themes/ with the same code the phone uses. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/ProseForge.Game/Engine/*.cs" Link="Engine/%(Filename)%(Extension)" />
    <Compile Include="../../src/ProseForge.Game/Themes/Theme.cs" Link="Themes/Theme.cs" />
    <Compile Include="../../src/ProseForge.Game/Themes/ThemeText.cs" Link="Themes/ThemeText.cs" />
    <Compile Include="../../src/ProseForge.Game/Themes/ThemeJson.cs" Link="Themes/ThemeJson.cs" />
    <Compile Include="../../src/ProseForge.Game/Themes/ThemePacks.cs" Link="Themes/ThemePacks.cs" />
    <Compile Include="../../src/ProseForge.Game/Themes/ThemeSwitch.cs" Link="Themes/ThemeSwitch.cs" />
    <Compile Include="../../src/ProseForge.Game/Themes/ScreenLayout.cs" Link="Themes/ScreenLayout.cs" />
  </ItemGroup>
</Project>
