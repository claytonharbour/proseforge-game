{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gameplay.schema.json",
  "title": "One More Story gameplay",
  "description": "A production line: the first station makes, each later one transforms.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "stations",
    "payout"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "description": "Must match the theme id"
    },
    "payout": {
      "enum": [
        "AnyStage",
        "FinalStageOnly"
      ],
      "description": "AnyStage: sell at any step. FinalStageOnly: only the last step earns."
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "secondsPerJob",
          "hireCost"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique in this line; saves are keyed by it"
          },
          "secondsPerJob": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "hireCost": {
            "type": "integer",
            "minimum": 0,
            "description": "First hire; each later hire costs another half of it"
          },
          "startingWorkers": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "sellPrice": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "What one finished item earns, if it can be sold"
          },
          "outputCap": {
            "type": "integer",
            "minimum": 1,
            "description": "Finished work waiting here stops at this"
          },
          "collectByHand": {
            "type": "boolean",
            "description": "The player taps to gather finished work"
          },
          "handoff": {
            "enum": [
              "ByHand",
              "Automatic"
            ],
            "default": "ByHand",
            "description": "How finished work reaches the next station"
          },
          "batchSize": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "A load only leaves when this many are waiting"
          },
          "needsTool": {
            "type": [
              "string",
              "null"
            ],
            "description": "A tool id: the step can't work more jobs at once than the tool allows"
          }
        }
      }
    },
    "tools": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "starting",
          "upgradeCost"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "starting": {
            "type": "integer",
            "minimum": 0
          },
          "upgradeCost": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "goal": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "delivered"
      ],
      "properties": {
        "delivered": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "powerUps": {
      "type": [
        "array",
        "null"
      ],
      "description": "Boosts bought with coins for a while, up to three: each gets its own dock button and clock, so they can run together. Buying one again while it runs restarts its clock.",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cost",
          "seconds",
          "effect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "cost": {
            "type": "integer",
            "minimum": 1
          },
          "seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 600
          },
          "effect": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "station"
            ],
            "description": "What a boost changes at a station. Speed divides the seconds a job takes (factor above 1); Batch adds items per job (add); Price multiplies (factor) and adds to (add) what one item sells for.",
            "properties": {
              "kind": {
                "enum": [
                  "Speed",
                  "Batch",
                  "Price"
                ]
              },
              "station": {
                "type": "string",
                "minLength": 1,
                "description": "A station id, or \"*\" for every station."
              },
              "factor": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10
              },
              "add": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "unlockAt": {
            "type": "integer",
            "minimum": 0,
            "description": "Items delivered before this power-up unlocks. Default 0: there from the start."
          },
          "every": {
            "type": "number",
            "minimum": 0,
            "maximum": 3600,
            "description": "Seconds between visits once unlocked. Default 0: always there."
          },
          "stays": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds each visit lasts; no more than every."
          }
        }
      }
    },
    "levels": {
      "type": [
        "array",
        "null"
      ],
      "description": "Boosts earned for good once enough has been delivered, listed in the order they're reached.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "delivered",
          "reward"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "delivered": {
            "type": "integer",
            "minimum": 1
          },
          "reward": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "station"
            ],
            "description": "What a boost changes at a station. Speed divides the seconds a job takes (factor above 1); Batch adds items per job (add); Price multiplies (factor) and adds to (add) what one item sells for.",
            "properties": {
              "kind": {
                "enum": [
                  "Speed",
                  "Batch",
                  "Price"
                ]
              },
              "station": {
                "type": "string",
                "minLength": 1,
                "description": "A station id, or \"*\" for every station."
              },
              "factor": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10
              },
              "add": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    }
  }
}
